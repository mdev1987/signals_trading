# systemd unit for the AVE hot-money paper/live bot.
# Install: copy to /etc/systemd/system/paper-bot.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now paper-bot
#
# Edit /opt/signals_trading_vector/.env before starting (never committed).
# Paper mode is the default and never signs or broadcasts anything.
# Live mode additionally needs LIVE_TRADING_ENABLED=1 and SOLANA_PRIVATE_KEY.

[Unit]
Description=AVE hot-money signal bot (paper/live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mdev/Programming/signals_trading_vector
ExecStart=/home/mdev/Programming/signals_trading_vector/run_bot.sh paper
# For live trading, change the ExecStart line to:
#   ExecStart=/home/mdev/Programming/signals_trading_vector/run_bot.sh live
# and set LIVE_TRADING_ENABLED=1 + SOLANA_PRIVATE_KEY in .env.

# Restart policy: always restart, with a backoff to avoid tight loops on
# persistent misconfiguration (e.g. bad API key).
Restart=always
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=300

# Environment file (gitignored, never committed).
EnvironmentFile=-/home/mdev/Programming/signals_trading_vector/.env

# Resource limits suited to a small VPS (2–4 GB RAM). The bot self-guards at
# 550 MB RSS and restarts cleanly; this is a hard ceiling.
MemoryMax=1G
MemorySwapMax=0

# Security: no new privileges, private /tmp, hide kernel details.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/mdev/Programming/signals_trading_vector/output /home/mdev/Programming/signals_trading_vector/tg_session.session
PrivateTmp=true
ProtectHome=true

# Logging to journald; the bot also writes output/paper/bot_YYYYMMDD.log.
StandardOutput=journal
StandardError=journal

# User: run as an unprivileged user, not root.
# User=mdev
# Group=mdev

[Install]
WantedBy=multi-user.target
