# systemd unit for the Pumpfun-scanner paper/live bot.
# Strategy: @AveSolanaTokenScanner -> scanner_pumpfun_amm (5 min hold).
# Install: copy to /etc/systemd/system/paper-bot.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now paper-bot
#
# Edit /home/mdev/Programming/signals_trading/.env before starting (never committed).
# Paper mode is the default and never signs or broadcasts anything.
# Live mode additionally needs LIVE_TRADING_ENABLED=1 and SOLANA_PRIVATE_KEY.

[Unit]
Description=Pumpfun scanner signal bot (paper/live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mdev/Programming/signals_trading
ExecStart=/home/mdev/Programming/signals_trading/run_bot.sh paper
# For live trading, change the ExecStart line to:
#   ExecStart=/home/mdev/Programming/signals_trading/run_bot.sh live
# and set LIVE_TRADING_ENABLED=1 + SOLANA_PRIVATE_KEY in .env.

# Restart policy: always restart, with a backoff to avoid tight loops on
# persistent misconfiguration (e.g. bad API key).
Restart=always
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=300

# Environment file (gitignored, never committed).
EnvironmentFile=-/home/mdev/Programming/signals_trading/.env

# Resource limits suited to a small VPS (2–4 GB RAM). The bot self-guards at
# 550 MB RSS and restarts cleanly; this is a hard ceiling.
MemoryMax=1G
MemorySwapMax=0

# Security: no new privileges, private /tmp, hide kernel details.
NoNewPrivileges=true
ProtectSystem=full
# Telethon keeps the SQLite session (and its -journal/-wal siblings) next to the
# repo, so the project root must stay writable. /home is otherwise read-only
# for this unit; ProtectHome=true would also hide the WorkingDirectory and stop
# the service from starting at all.
ReadWritePaths=/home/mdev/Programming/signals_trading
PrivateTmp=true
ProtectHome=read-only

# Logging to journald; the bot also writes output/paper/bot_YYYYMMDD.log.
StandardOutput=journal
StandardError=journal

# User: run as an unprivileged user, not root.
# User=mdev
# Group=mdev

[Install]
WantedBy=multi-user.target
