# Copy to .env and fill in the values. Never commit .env (gitignored).
#
# Paper mode only needs JUPITER_API_KEY (read-only quotes). Live execution also
# needs SOLANA_PRIVATE_KEY, SOLANA_RPC_URL and LIVE_TRADING_ENABLED=1.

# Jupiter Swap API (x-api-key header). Required in both modes for quotes.
JUPITER_API_KEY=replace_with_your_jupiter_api_key

# Solana RPC used by the live executor.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base58 secret key for the live taker wallet. Leave blank in paper mode.
SOLANA_PRIVATE_KEY=

# Optional on-chain mint-authority / safety checks.
HELIUS_API_KEY=
RPC_URL_GATEKEEPER=https://beta.helius-rpc.com/?api-key=

# Telegram reporting bot (not the signal listener).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telethon user session used to read the signal channels.
# Credentials are in config.ini (api_id, api_hash, phone).
# Run once:  PYTHONPATH=src .venv/bin/python -m paper_bot login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Live execution is opt-in: it needs BOTH --mode live and LIVE_TRADING_ENABLED=1.
LIVE_TRADING_ENABLED=0
LIVE_MINT_ALLOWLIST=
LIVE_STARTING_SOL=10

# Priority fee (lamports) and Jito MEV tip (lamports) help live transactions
# land faster during volatile pump launches, reducing entry slippage.
# Set to 0 to let Jupiter determine fees automatically.
# Example values: 1000-5000 lamports for priority fee, 10000-100000 for Jito tip.
LIVE_PRIORITY_FEE_LAMPORTS=0
LIVE_JITO_TIP_LAMPORTS=0
